---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";
import { ButtonLink } from "@ulubit/ui";
import GithubIcon from "@/assets/github.svg"

const title = siteConfig.title
const description = siteConfig.description
const bodyClass = "page-home"
---
<BaseLayout {title} {description} {bodyClass}>
  <main id="main-content">
    <section class="hero">
      <div class="container">
        <div class="hero-copy">
          <h1 class="heading">{title}</h1>
          <p class="description">{description}</p>
        </div>
        <div class="hero-cta">
          <ButtonLink href="https://docs-ulubit.netlify.app">
            Read the docs
          </ButtonLink>

          <ButtonLink
            href="https://github.com/rodrigoperochena/ulubit-astro-starter"
            target="_blank" rel="noopener noreferrer"
            variant="secondary"
          >
            <GithubIcon slot={"start"} />
            View on Github
          </ButtonLink>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  @use "@ulubit/foundations/breakpoints" as *;

  .hero {
    display: grid;
    align-items: center;
    
    @media (height <= 42rem) {
      height: 100%;
    }

    @media (42rem <= height) {
      height: 80%;
    }

    @include at(xl) {
      justify-content: center;
      text-align: center;
    }

    .container {
      padding-inline: var(--space-l);
    }
  }

  .hero-copy {
    max-width: var(--container-3xl);
  }

  h1 {
    font-size: var(--step-5);
    line-height: 1.2;
    max-width: 30ch;
  }
  
  .description {
    font-size: var(--step-1);
    max-width: 65ch;
    line-height: var(--phi);
    margin-top: var(--space-m);

    @include at(xl) {
      margin-inline: auto;
    }
  }

  .hero-cta {
    margin-top: var(--space-l);
    display: flex;
    gap: var(--space-xs) var(--space-s);
    flex-wrap: wrap;

    @include at(xl) {
      justify-content: center;
    }
  }
</style>