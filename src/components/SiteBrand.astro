---
import Logo from "@/assets/logo.svg"
import { siteConfig } from "@/site.config"

type Variant = "name" | "logo" | "combined"
type Size = "sm" | "md" | "lg"

interface Props {
  href?: string
  variant?: Variant
  size?: Size
  class?: string
}

const {
  href = "/",
  variant = "combined",
  size = "md",
  class: className
} = Astro.props

const showLogo = variant !== "name"
const showName = variant !== "logo"
const accessibleLabel = variant === "logo" ? siteConfig.brand.name : undefined
---

<a 
  {href}
  class:list={["brand", `brand-${size}`, className]}
  aria-label={accessibleLabel}
>
  {showLogo && (
    <span class="brand-logo" aria-hidden="true"><Logo /></span>
  )}
  {showName && (
    <span class="brand-name">{siteConfig.brand.name}</span>
  )}
</a>

<style lang="scss">
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    color: inherit;
    text-decoration: none;
  }

  .brand-logo {
    svg {
      height: var(--brand-logo-size);
      width: auto;
    }
  }

  .brand-name {
    font-size: var(--brand-name-size);
    font-weight: var(--font-semibold);
    line-height: 1;
  }

  .brand-sm {
    --brand-logo-size: var(--step-0);
    --brand-name-size: var(--step--1);
  }

  .brand-md {
    --brand-logo-size: var(--step-1);
    --brand-name-size: var(--step-0);
  }

  .brand-lg {
    --brand-logo-size: var(--step-2);
    --brand-name-size: var(--step-1);
  }

  .brand:focus-visible {
    outline: .125rem solid currentColor;
    outline-offset: .25rem;
    border-radius: .125rem;
  }
</style>