---
import SiteBrand from "./SiteBrand.astro"
import SiteNavigation from "./SiteNavigation.astro"
---
<header class="site-header" data-site-header>
  <div class="container">
    <SiteBrand />
    <SiteNavigation />
  </div>
</header>

<style lang="scss">
  @use "@ulubit/foundations/breakpoints" as *;

  header {
    position: fixed;
    top: 0;
    height: var(--header-height);
    width: 100%;
    z-index: 2;
    transition: var(--transition-duration);

    display: grid;
    align-content: center;
  }

  .container {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    max-width: 100%;
    position: relative;
  }
</style>