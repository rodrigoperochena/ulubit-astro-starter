---
import { UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from 'astro:env/server'

const isProd = import.meta.env.PROD
const shouldLoadAnalytics = isProd && UMAMI_WEBSITE_ID && UMAMI_SCRIPT_URL
---
{shouldLoadAnalytics && (
  <script 
    is:inline 
    defer 
    src={UMAMI_SCRIPT_URL}
    data-website-id={UMAMI_WEBSITE_ID}
  ></script>
)}